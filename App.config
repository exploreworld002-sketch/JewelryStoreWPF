<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>

	<connectionStrings>
		<add name="DefaultConnection"
			 connectionString="Server=YOUR_SERVER_NAME;Database=JewelryDB;Trusted_Connection=True;MultipleActiveResultSets=true;"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>
</configuration>
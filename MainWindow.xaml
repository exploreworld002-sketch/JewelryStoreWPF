<!--
PERFORMANCE OPTIMIZATIONS APPLIED:
1. Removed heavy DropShadowEffects (major performance killer)
2. Simplified glassmorphism with solid colors instead of transparent overlays
3. Reduced nested panels and complex layouts
4. Optimized gradients and animations
5. Added UI virtualization for lists
6. Streamlined resource styles
-->

<Window x:Class="JewelryStoreWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="💎 Luxury Jewelry Management System" 
        Height="1000" Width="1600"
        WindowStyle="None" 
        AllowsTransparency="False"
        Background="#0f0f23"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        RenderOptions.BitmapScalingMode="HighQuality">

    <Window.Resources>
        <!-- OPTIMIZED: Simplified glass panel with solid background instead of transparent overlay -->
        <Style x:Key="OptimizedGlassPanelDark" TargetType="Border">
            <Setter Property="Background" Value="#1e1e3a"/>
            <Setter Property="BorderBrush" Value="#333366"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="15"/>
            <!-- Removed DropShadowEffect for major performance gain -->
        </Style>

        <Style x:Key="OptimizedGlassPanelLight" TargetType="Border">
            <Setter Property="Background" Value="#f8f9fa"/>
            <Setter Property="BorderBrush" Value="#dee2e6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="15"/>
        </Style>

        <!-- OPTIMIZED: Simplified button style -->
        <Style x:Key="OptimizedModernButton" TargetType="Button">
            <Setter Property="Background" Value="#667eea"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#7c8ef0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#5a6fd8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- OPTIMIZED: Simplified stats card -->
        <Style x:Key="OptimizedStatsCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="15"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#667eea"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- OPTIMIZED: Navigation button -->
        <Style x:Key="OptimizedNavButtonDark" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Margin="5,2">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                            VerticalAlignment="Center"
                                            Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#667eea"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- OPTIMIZED: High-performance ListView style -->
        <Style x:Key="OptimizedListViewDark" TargetType="ListView">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <!-- Enable virtualization for performance -->
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        </Style>

        <Style x:Key="OptimizedTextBlockDark" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="OptimizedTextBlockLight" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#333333"/>
        </Style>
    </Window.Resources>

    <!-- OPTIMIZED: Simplified main container -->
    <Grid Name="MainGrid" Background="#0f0f23">

        <!-- OPTIMIZED: Simplified title bar -->
        <Border Height="50" VerticalAlignment="Top" 
                Background="#1a1a2e" 
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <StackPanel Orientation="Horizontal" 
                           HorizontalAlignment="Left" 
                           VerticalAlignment="Center" 
                           Margin="20,0">
                    <TextBlock Text="💎" FontSize="18" VerticalAlignment="Center" Name="TitleIcon" Style="{StaticResource OptimizedTextBlockDark}"/>
                    <TextBlock Text="LUXURY JEWELRY STORE" 
                              FontSize="14" 
                              FontWeight="Bold" 
                              VerticalAlignment="Center" 
                              Margin="10,0"
                              Name="TitleText"
                              Style="{StaticResource OptimizedTextBlockDark}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" 
                           HorizontalAlignment="Right" 
                           VerticalAlignment="Center" 
                           Margin="0,0,10,0">
                    <Button Content="🌙" 
                           Width="35" Height="25" 
                           Background="Transparent" 
                           Foreground="White" 
                           BorderThickness="0" 
                           FontSize="12"
                           Click="ThemeToggle_Click"
                           Cursor="Hand"
                           Name="ThemeToggleButton"/>
                    <Button Content="−" 
                           Width="35" Height="25" 
                           Background="Transparent" 
                           Foreground="White" 
                           BorderThickness="0" 
                           FontSize="14"
                           Click="Minimize_Click"
                           Cursor="Hand"/>
                    <Button Content="✕" 
                           Width="35" Height="25" 
                           Background="Transparent" 
                           Foreground="#ff6b6b" 
                           BorderThickness="0" 
                           FontSize="12"
                           Click="Close_Click"
                           Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- OPTIMIZED: Main content grid -->
        <Grid Margin="0,50,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- OPTIMIZED: Simplified sidebar -->
            <Border Grid.Column="0" Name="SidebarBorder" Style="{StaticResource OptimizedGlassPanelDark}" Margin="15">
                <StackPanel Margin="0,25,0,0" Name="NavigationPanel">
                    <Button Content="🏠  Dashboard" Name="DashboardBtn" Style="{StaticResource OptimizedNavButtonDark}" Background="#667eea"/>
                    <Button Content="👥  Customers" Name="CustomersBtn" Style="{StaticResource OptimizedNavButtonDark}"/>
                    <Button Content="💍  Inventory" Name="InventoryBtn" Style="{StaticResource OptimizedNavButtonDark}"/>
                    <Button Content="💰  Sales" Name="SalesBtn" Style="{StaticResource OptimizedNavButtonDark}"/>
                    <Button Content="🛒  Purchase" Name="PurchaseBtn" Style="{StaticResource OptimizedNavButtonDark}"/>
                    <Button Content="📊  Analytics" Name="AnalyticsBtn" Style="{StaticResource OptimizedNavButtonDark}"/>
                    <Button Content="📈  Reports" Name="ReportsBtn" Style="{StaticResource OptimizedNavButtonDark}"/>
                    <Button Content="⚙️  Settings" Name="SettingsBtn" Style="{StaticResource OptimizedNavButtonDark}"/>
                </StackPanel>
            </Border>

            <!-- OPTIMIZED: Main content with virtualized scrolling -->
            <ScrollViewer Grid.Column="1" 
                         VerticalScrollBarVisibility="Auto" 
                         Margin="15"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                <StackPanel>
                    <!-- OPTIMIZED: Welcome section with solid background -->
                    <Border CornerRadius="20" Margin="0,0,0,25" Name="WelcomeBorder" Background="#667eea" Height="120">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="30">
                            <TextBlock Text="Welcome back, Admin! ✨" 
                                      FontSize="28" 
                                      FontWeight="Bold" 
                                      Foreground="White"/>
                            <TextBlock Name="DateTimeText"
                                      Text="Loading..." 
                                      FontSize="14" 
                                      Foreground="White" 
                                      Opacity="0.9" 
                                      Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- OPTIMIZED: Stats cards with simplified layout -->
                    <Grid Margin="0,0,0,25" Name="StatsGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <!-- Total Sales Card -->
                        <Border Grid.Column="0" Style="{StaticResource OptimizedStatsCard}" Margin="0,0,10,0" Background="#43e97b" Height="140">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="💰" FontSize="32" HorizontalAlignment="Center"/>
                                <TextBlock Text="Total Sales Today" 
                                          FontSize="12" 
                                          Foreground="White" 
                                          HorizontalAlignment="Center" 
                                          Margin="0,8,0,0"/>
                                <TextBlock Text="₹2,45,000" 
                                          FontSize="20" 
                                          FontWeight="Bold" 
                                          Foreground="White" 
                                          HorizontalAlignment="Center" 
                                          Margin="0,4,0,0"/>
                                <TextBlock Text="+12.5%" 
                                          FontSize="10" 
                                          Foreground="White" 
                                          Opacity="0.8" 
                                          HorizontalAlignment="Center" 
                                          Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Orders Pending Card -->
                        <Border Grid.Column="1" Style="{StaticResource OptimizedStatsCard}" Margin="10,0" Background="#f5576c" Height="140">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="⏳" FontSize="32" HorizontalAlignment="Center"/>
                                <TextBlock Text="Orders Pending" 
                                          FontSize="12" 
                                          Foreground="White" 
                                          HorizontalAlignment="Center" 
                                          Margin="0,8,0,0"/>
                                <TextBlock Text="23" 
                                          FontSize="20" 
                                          FontWeight="Bold" 
                                          Foreground="White" 
                                          HorizontalAlignment="Center" 
                                          Margin="0,4,0,0"/>
                                <TextBlock Text="+8.2%" 
                                          FontSize="10" 
                                          Foreground="White" 
                                          Opacity="0.8" 
                                          HorizontalAlignment="Center" 
                                          Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Total Customers Card -->
                        <Border Grid.Column="2" Style="{StaticResource OptimizedStatsCard}" Margin="10,0" Background="#4facfe" Height="140">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="👥" FontSize="32" HorizontalAlignment="Center"/>
                                <TextBlock Text="Total Customers" 
                                          FontSize="12" 
                                          Foreground="White" 
                                          HorizontalAlignment="Center" 
                                          Margin="0,8,0,0"/>
                                <TextBlock Text="1,247" 
                                          FontSize="20" 
                                          FontWeight="Bold" 
                                          Foreground="White" 
                                          HorizontalAlignment="Center" 
                                          Margin="0,4,0,0"/>
                                <TextBlock Text="+15.3%" 
                                          FontSize="10" 
                                          Foreground="White" 
                                          Opacity="0.8" 
                                          HorizontalAlignment="Center" 
                                          Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Inventory Value Card -->
                        <Border Grid.Column="3" Style="{StaticResource OptimizedStatsCard}" Margin="10,0,0,0" Background="#764ba2" Height="140">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="💍" FontSize="32" HorizontalAlignment="Center"/>
                                <TextBlock Text="Inventory Value" 
                                          FontSize="12" 
                                          Foreground="White" 
                                          HorizontalAlignment="Center" 
                                          Margin="0,8,0,0"/>
                                <TextBlock Text="₹45,67,890" 
                                          FontSize="20" 
                                          FontWeight="Bold" 
                                          Foreground="White" 
                                          HorizontalAlignment="Center" 
                                          Margin="0,4,0,0"/>
                                <TextBlock Text="+5.7%" 
                                          FontSize="10" 
                                          Foreground="White" 
                                          Opacity="0.8" 
                                          HorizontalAlignment="Center" 
                                          Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- OPTIMIZED: Charts and Quick Actions -->
                    <Grid Margin="0,0,0,25">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Sales Chart -->
                        <Border Grid.Column="0" Name="ChartBorder" Style="{StaticResource OptimizedGlassPanelDark}" Margin="0,0,10,0" Height="300">
                            <StackPanel Margin="25">
                                <TextBlock Text="📈 Sales Analytics - Last 7 Days" 
                                          FontSize="16" 
                                          FontWeight="Bold" 
                                          Margin="0,0,0,15"
                                          Name="ChartTitle"
                                          Style="{StaticResource OptimizedTextBlockDark}"/>

                                <!-- Simplified chart canvas -->
                                <Canvas Name="ChartCanvas" Height="200" Background="Transparent"/>
                            </StackPanel>
                        </Border>

                        <!-- Quick Actions -->
                        <Border Grid.Column="1" Name="QuickActionsBorder" Style="{StaticResource OptimizedGlassPanelDark}" Margin="10,0,0,0" Height="300">
                            <StackPanel Margin="25">
                                <TextBlock Text="⚡ Quick Actions" 
                                          FontSize="16" 
                                          FontWeight="Bold" 
                                          Margin="0,0,0,15"
                                          Name="QuickActionsTitle"
                                          Style="{StaticResource OptimizedTextBlockDark}"/>

                                <Button Content="🛍️ New Sale" Style="{StaticResource OptimizedModernButton}" Margin="0,0,0,10"/>
                                <Button Content="👤 Add Customer" Style="{StaticResource OptimizedModernButton}" Margin="0,0,0,10"/>
                                <Button Content="💍 Add Product" Style="{StaticResource OptimizedModernButton}" Margin="0,0,0,10"/>
                                <Button Content="📊 Generate Report" Style="{StaticResource OptimizedModernButton}" Margin="0,0,0,10"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- OPTIMIZED: Recent Sales and Alerts -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <!-- Recent Sales with virtualization -->
                        <Border Grid.Column="0" Name="SalesBorder" Style="{StaticResource OptimizedGlassPanelDark}" Margin="0,0,10,0" Height="350">
                            <StackPanel Margin="25">
                                <TextBlock Text="🛍️ Recent Sales" 
                                          FontSize="16" 
                                          FontWeight="Bold" 
                                          Margin="0,0,0,15"
                                          Name="SalesTitle"
                                          Style="{StaticResource OptimizedTextBlockDark}"/>

                                <!-- OPTIMIZED: Virtualized ListView for performance -->
                                <ListView Name="SalesListView" 
                                         Height="250"
                                         Style="{StaticResource OptimizedListViewDark}"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         ScrollViewer.CanContentScroll="True">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Customer" Width="120" DisplayMemberBinding="{Binding CustomerName}"/>
                                            <GridViewColumn Header="Item" Width="100" DisplayMemberBinding="{Binding Item}"/>
                                            <GridViewColumn Header="Amount" Width="80" DisplayMemberBinding="{Binding Amount, StringFormat=₹{0:N0}}"/>
                                            <GridViewColumn Header="Date" Width="70" DisplayMemberBinding="{Binding Date, StringFormat=MMM dd}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <!-- Low Stock Alerts -->
                        <Border Grid.Column="1" Name="AlertsBorder" Style="{StaticResource OptimizedGlassPanelDark}" Margin="10,0,0,0" Height="350">
                            <StackPanel Margin="25">
                                <TextBlock Text="⚠️ Low Stock Alerts" 
                                          FontSize="16" 
                                          FontWeight="Bold" 
                                          Foreground="#ff6b6b" 
                                          Margin="0,0,0,15"/>

                                <StackPanel Name="AlertsPanel"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
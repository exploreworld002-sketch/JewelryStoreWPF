<Window x:Class="JewelryStoreWPF.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="💎 Luxury Jewelry Store - Login"
        Height="900" Width="1400"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        WindowState="Maximized"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- Simplified Cached Brushes -->
        <SolidColorBrush x:Key="WhiteBrush05" Color="White" Opacity="0.05"/>
        <SolidColorBrush x:Key="WhiteBrush1" Color="White" Opacity="0.1"/>
        <SolidColorBrush x:Key="WhiteBrush3" Color="White" Opacity="0.3"/>
        <SolidColorBrush x:Key="WhiteBrush8" Color="White" Opacity="0.8"/>
        <SolidColorBrush x:Key="WhiteBrush9" Color="White" Opacity="0.9"/>
        <SolidColorBrush x:Key="GrayBrush3" Color="Gray" Opacity="0.3"/>
        <SolidColorBrush x:Key="GrayBrush4" Color="Gray" Opacity="0.4"/>
        <SolidColorBrush x:Key="DarkTextBrush" Color="#333333"/>
        <SolidColorBrush x:Key="WhiteBrush" Color="White"/>

        <!-- Simplified Gradient Brushes -->
        <LinearGradientBrush x:Key="MainGradientBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#667eea" Offset="0"/>
            <GradientStop Color="#764ba2" Offset="1"/>
        </LinearGradientBrush>

        <!-- Minimal Shadow Effects (reduced blur radius) -->
        <DropShadowEffect x:Key="LightShadow" Color="Black" BlurRadius="8" ShadowDepth="2" Opacity="0.2"/>
        <DropShadowEffect x:Key="FocusGlow" Color="#667eea" BlurRadius="8" ShadowDepth="0" Opacity="0.3"/>

        <!-- Simplified Glass Panel Dark -->
        <Style x:Key="GlassPanelDark" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource WhiteBrush05}"/>
            <Setter Property="BorderBrush" Value="{StaticResource WhiteBrush1}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="20"/>
        </Style>

        <!-- Simplified Glass Panel Light -->
        <Style x:Key="GlassPanelLight" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource WhiteBrush8}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GrayBrush3}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Effect" Value="{StaticResource LightShadow}"/>
        </Style>

        <!-- Fixed TextBox Styles with Visible Text -->
        <Style x:Key="ModernTextBoxDark" TargetType="TextBox">
            <Setter Property="Background" Value="#26293a"/>
            <Setter Property="Foreground" Value="#EAEAEA"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource MainGradientBrush}"/>
                                <Setter Property="Background" Value="#30344d"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



        <Style x:Key="ModernTextBoxLight" TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="{StaticResource GrayBrush4}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="CaretBrush" Value="#333333"/>
            <Setter Property="SelectionBrush" Value="{StaticResource MainGradientBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                               BorderBrush="{TemplateBinding BorderBrush}"
                               BorderThickness="{TemplateBinding BorderThickness}"
                               CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                         Margin="{TemplateBinding Padding}"
                                         VerticalAlignment="Center"
                                         Focusable="False"
                                         HorizontalScrollBarVisibility="Hidden"
                                         VerticalScrollBarVisibility="Hidden"
                                         Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource MainGradientBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fixed PasswordBox Styles with Visible Text -->
        <Style x:Key="ModernPasswordBoxDark" TargetType="PasswordBox">
            <Setter Property="Background" Value="#26293a"/>
            <Setter Property="Foreground" Value="#EAEAEA"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource MainGradientBrush}"/>
                                <Setter Property="Background" Value="#30344d"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



        <Style x:Key="ModernPasswordBoxLight" TargetType="PasswordBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="{StaticResource GrayBrush4}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="15,12,50,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}" 
                               BorderBrush="{TemplateBinding BorderBrush}"
                               BorderThickness="{TemplateBinding BorderThickness}"
                               CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                         Margin="{TemplateBinding Padding}"
                                         VerticalAlignment="Center"
                                         Focusable="False"
                                         HorizontalScrollBarVisibility="Hidden"
                                         VerticalScrollBarVisibility="Hidden"
                                         Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource MainGradientBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Simplified Eye Button Styles -->
        <Style x:Key="EyeToggleButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource WhiteBrush3}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                               CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EyeToggleButtonLight" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource GrayBrush4}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                               CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DarkTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Simplified Login Button -->
        <Style x:Key="LoginButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource MainGradientBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="40,15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                               CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text Styles -->
        <Style x:Key="TextBlockDark" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
        </Style>

        <Style x:Key="TextBlockLight" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DarkTextBrush}"/>
        </Style>

        <!-- Simplified Notification Style -->
        <Style x:Key="NotificationBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="15,8"/>
        </Style>
    </Window.Resources>

    <!-- Main Container -->
    <Grid Name="MainGrid">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0f0f23" Offset="0"/>
                <GradientStop Color="#1a1a2e" Offset="0.5"/>
                <GradientStop Color="#16213e" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Custom Title Bar -->
        <Border Height="50" VerticalAlignment="Top" 
                Background="Transparent" 
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <StackPanel Orientation="Horizontal" 
                           HorizontalAlignment="Left" 
                           VerticalAlignment="Center" 
                           Margin="20,0">
                    <TextBlock Text="💎" FontSize="18" VerticalAlignment="Center" Name="TitleIcon" Style="{StaticResource TextBlockDark}"/>
                    <TextBlock Text="LUXURY JEWELRY STORE - LOGIN" 
                              FontSize="14" 
                              FontWeight="Bold" 
                              VerticalAlignment="Center" 
                              Margin="8,0"
                              Name="TitleText"
                              Style="{StaticResource TextBlockDark}"/>
                </StackPanel>

                <!-- Window Controls -->
                <StackPanel Orientation="Horizontal" 
                           HorizontalAlignment="Right" 
                           VerticalAlignment="Center" 
                           Margin="0,0,10,0">
                    <Button Content="🌙" 
                           Width="35" Height="28" 
                           Background="Transparent" 
                           Foreground="{StaticResource WhiteBrush}" 
                           BorderThickness="0" 
                           FontSize="12"
                           Click="ThemeToggle_Click"
                           Cursor="Hand"
                           Name="ThemeToggleButton"/>
                    <Button x:Name="btnMinimized" Content="−" 
                           Width="35" Height="28" 
                           Background="Transparent" 
                           Foreground="{StaticResource WhiteBrush}" 
                           BorderThickness="0" 
                           FontSize="14"
                           Click="Minimize_Click"
                           Cursor="Hand"/>
                    <Button Content="✕" 
                           Width="35" Height="28" 
                           Background="Transparent" 
                           Foreground="#ff6b6b" 
                           BorderThickness="0" 
                           FontSize="12"
                           Click="Close_Click"
                           Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Login Content -->
        <Grid Margin="0,50,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Side - Simplified Branding -->
            <Grid Grid.Column="0">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40">
                    <!-- Simple Logo -->
                    <Border Name="LogoBorder" 
                            Width="120" Height="120" 
                            CornerRadius="60"
                            Background="{StaticResource MainGradientBrush}"
                            Margin="0,0,0,20">
                        <TextBlock Text="💎" 
                                  FontSize="50" 
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource WhiteBrush}"/>
                    </Border>

                    <TextBlock Text="LUXURY JEWELRY" 
                              FontSize="28" 
                              FontWeight="Bold" 
                              HorizontalAlignment="Center"
                              Name="BrandTitle"
                              Style="{StaticResource TextBlockDark}"/>

                    <TextBlock Text="MANAGEMENT SYSTEM" 
                              FontSize="18" 
                              FontWeight="Medium" 
                              HorizontalAlignment="Center"
                              Margin="0,5,0,15"
                              Name="BrandSubtitle"
                              Style="{StaticResource TextBlockDark}"/>

                    <TextBlock Text="Experience luxury with our premium jewelry platform" 
                              FontSize="14" 
                              HorizontalAlignment="Center"
                              TextAlignment="Center"
                              TextWrapping="Wrap"
                              Opacity="0.8"
                              Margin="0,0,0,20"
                              Name="BrandDescription"
                              Style="{StaticResource TextBlockDark}"/>

                    <!-- Simplified Features -->
                    <StackPanel Name="FeaturesPanel">
                        <Border Background="#667eea" 
                                CornerRadius="15" 
                                Padding="12,8" 
                                Margin="0,4"
                                Style="{StaticResource NotificationBorder}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔒" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Advanced Security" FontSize="12" Foreground="{StaticResource WhiteBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#764ba2" 
                                CornerRadius="15" 
                                Padding="12,8" 
                                Margin="0,4"
                                Style="{StaticResource NotificationBorder}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Real-time Analytics" FontSize="12" Foreground="{StaticResource WhiteBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#43e97b" 
                                CornerRadius="15" 
                                Padding="12,8" 
                                Margin="0,4"
                                Style="{StaticResource NotificationBorder}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💍" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Inventory Management" FontSize="12" Foreground="{StaticResource WhiteBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Center - Login Form -->
            <Border Grid.Column="1" 
                    Name="LoginBorder"
                    Style="{StaticResource GlassPanelDark}"
                    VerticalAlignment="Center"
                    Height="500"
                    Margin="20">

                <StackPanel VerticalAlignment="Center" Margin="40">
                    <!-- Login Header -->
                    <TextBlock Text="✨ Welcome Back ✨" 
                              FontSize="24" 
                              FontWeight="Bold" 
                              HorizontalAlignment="Center"
                              Margin="0,0,0,8"
                              Name="LoginTitle"
                              Style="{StaticResource TextBlockDark}"/>

                    <TextBlock Text="Sign in to access your dashboard" 
                              FontSize="14" 
                              HorizontalAlignment="Center"
                              Opacity="0.8"
                              Margin="0,0,0,30"
                              Name="LoginSubtitle"
                              Style="{StaticResource TextBlockDark}"/>

                    <!-- Username Input -->
                    <TextBlock Text="Username" 
                              FontSize="12" 
                              FontWeight="SemiBold"
                              Margin="0,0,0,6"
                              Name="UsernameLabel"
                              Style="{StaticResource TextBlockDark}"/>

                    <TextBox Name="UsernameTextBox" 
                            Style="{StaticResource ModernTextBoxDark}"
                            Height="45"
                            Margin="0,0,0,20" FontFamily="Segoe UI Black"/>

                    <!-- Password Input -->
                    <TextBlock Text="Password" 
                               FontSize="12" 
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"
                               Name="PasswordLabel"
                               Style="{StaticResource TextBlockDark}"/>

                    <!-- Password Container with Fixed Layout -->
                    <!-- Password Container with Fixed Layout -->
                    <Grid Height="45" Margin="0,0,0,25">
                        <!-- PasswordBox -->
                        <!-- PasswordBox -->
                        <PasswordBox Name="PasswordBox" 
             Style="{StaticResource ModernPasswordBoxDark}"
             Height="45"
             Padding="15,8,45,8" 
             FontFamily="Segoe UI"
             FontWeight="Bold"
             VerticalContentAlignment="Center"/>

                        <!-- TextBox (for show password) -->
                        <TextBox Name="PasswordTextBox" 
         Style="{StaticResource ModernTextBoxDark}"
         Height="45"
         Visibility="Collapsed"
         Padding="15,8,45,8"
         FontFamily="Segoe UI"
         FontWeight="Bold"
         VerticalContentAlignment="Center"/>


                        <!-- Eye Toggle Button -->
                        <Button Name="EyeToggleButton"
            Content="👁"
            Style="{StaticResource EyeToggleButton}"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Margin="0,0,10,0"
            Width="30" Height="30" Click="EyeToggleButton_Click"/>
                    </Grid>


                    <!-- Error Message -->
                    <Border Name="ErrorBorder" 
                            Visibility="Collapsed"
                            Background="#ff6b6b"
                            CornerRadius="8"
                            Padding="12,8"
                            Margin="0,0,0,15"
                            Style="{StaticResource NotificationBorder}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="❌" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Name="ErrorText" 
                                      Text="Invalid username or password!" 
                                      FontSize="12" 
                                      Foreground="{StaticResource WhiteBrush}" 
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Login Button -->
                    <Button Name="LoginButton"
                           Content="🚀 LOGIN TO DASHBOARD"
                           Style="{StaticResource LoginButton}"
                           Height="50"
                           Click="LoginButton_Click"
                           Margin="0,0,0,25"/>

                    <!-- Footer -->
                    <StackPanel Orientation="Horizontal" 
                               HorizontalAlignment="Center"
                               Opacity="0.6">
                        <TextBlock Text="🔐 Secure Login • " 
                                  FontSize="10"
                                  Name="FooterText1"
                                  Style="{StaticResource TextBlockDark}"/>
                        <TextBlock Text="Protected by Advanced Encryption" 
                                  FontSize="10"
                                  Name="FooterText2"
                                  Style="{StaticResource TextBlockDark}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Right Side - Simplified Stats -->
            <Grid Grid.Column="2">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40" Name="StatsPreview">
                    <!-- Mini Stats Cards -->
                    <Border Background="#43e97b" 
                            CornerRadius="15" 
                            Padding="15,12" 
                            Margin="0,8"
                            Width="200"
                            Style="{StaticResource NotificationBorder}">
                        <StackPanel>
                            <TextBlock Text="💰" FontSize="20" HorizontalAlignment="Center"/>
                            <TextBlock Text="Today's Sales" FontSize="12" Foreground="{StaticResource WhiteBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            <TextBlock Text="₹2,45,000" FontSize="16" FontWeight="Bold" Foreground="{StaticResource WhiteBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#4facfe" 
                            CornerRadius="15" 
                            Padding="15,12" 
                            Margin="0,8"
                            Width="200"
                            Style="{StaticResource NotificationBorder}">
                        <StackPanel>
                            <TextBlock Text="👥" FontSize="20" HorizontalAlignment="Center"/>
                            <TextBlock Text="Active Customers" FontSize="12" Foreground="{StaticResource WhiteBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            <TextBlock Text="1,247" FontSize="16" FontWeight="Bold" Foreground="{StaticResource WhiteBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#f093fb" 
                            CornerRadius="15" 
                            Padding="15,12" 
                            Margin="0,8"
                            Width="200"
                            Style="{StaticResource NotificationBorder}">
                        <StackPanel>
                            <TextBlock Text="⏳" FontSize="20" HorizontalAlignment="Center"/>
                            <TextBlock Text="Pending Orders" FontSize="12" Foreground="{StaticResource WhiteBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            <TextBlock Text="23" FontSize="16" FontWeight="Bold" Foreground="{StaticResource WhiteBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Success Notification -->
        <Border Name="SuccessNotification"
                Background="#43e97b"
                CornerRadius="12"
                Padding="18,12"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,80,0,0"
                Visibility="Collapsed"
                Style="{StaticResource NotificationBorder}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="✅" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Text="Login Successful! Redirecting to Dashboard..." 
                          FontSize="14" 
                          FontWeight="Bold"
                          Foreground="{StaticResource WhiteBrush}" 
                          VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>